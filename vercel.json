{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    {
      "source": "/privacy",
      "destination": "/politica-de-privacidade",
      "permanent": true
    },
    {
      "source": "/privacy.html",
      "destination": "/politica-de-privacidade",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/politica-de-privacidade",
      "destination": "/politica-de-privacidade.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
